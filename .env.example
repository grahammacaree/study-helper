# User API key from https://cursor.com/dashboard/api
# The SDK does not read this file; the server loads it via dotenv.
CURSOR_API_KEY=cursor_...

# Optional. Default composer-2.5
# CURSOR_MODEL=composer-2.5

# Optional. Default 8790
# PORT=8790

# Optional. Absolute path to a local personal-site checkout.
# Used only by gitignored local/personal-site.ts when you initialise a course.
# PERSONAL_SITE_ROOT=
