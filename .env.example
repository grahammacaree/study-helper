# User API key from https://cursor.com/dashboard/api
# The SDK does not read this file; the server loads it via dotenv.
CURSOR_API_KEY=cursor_...

# Optional. Default composer-2.5
# CURSOR_MODEL=composer-2.5

# Optional. Default 8790
# PORT=8790

# Optional. Absolute path to a local personal-site checkout.
# Used only by gitignored local/personal-site.ts when you initialise or close a course.
# PERSONAL_SITE_ROOT=

# Optional. Host POST of a proved *claim* (not the lecture summary) to leansearch.net,
# then a GitHub fetch of that mathlib file by module path, then one translation turn.
# MATHLIB_SEARCH=0

# Optional. TypeSafe / Jev (server-side only; never commit the key).
# Off without a key, or with TYPESAFE=0. Fail-open: missing/timeout uses the old path.
# TYPESAFE=0
# TYPESAFE_API_KEY=
